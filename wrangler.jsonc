// Cloudflare Worker settings. The whole repo is still published as static files
// (minus what .assetsignore lists); only /api/... runs worker/index.js.
{
  "name": "smart-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Favourite alerts are saved in one SQLite Durable Object and checked every minute.
  "durable_objects": { "bindings": [{ "name": "ALERTS", "class_name": "AlertStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertStore"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "VAPID_SUBJECT": "https://smart-dashboard.ty-projects.workers.dev/"
  }
  // Secrets (set in Cloudflare, never committed): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY.
}
